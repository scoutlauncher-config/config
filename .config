# Each [section] below adds one shop tile to the game page, in file order.
# Add as many stores as you like — the tiles lay out dynamically.
# Lines starting with # or ; are comments.
#
#   [Humble]          starts a shop; the header text is its display name
#                     (a "name =" key overrides it, and a plain [store]
#                      header works if you'd rather name it via the key)
#
#   id = <number>     REQUIRED —  store ID
#               
#   url = <template>  REQUIRED — what the shop tile links to; its domain is
#                     also what the search fallback is restricted to.
#                     Placeholders:
#                       {slug}        lowercase-hyphenated title (dark-souls-iii)
#                       {title}       URL-encoded raw title
#                       {dealID}      deal ID
#                       {steamAppID}  Steam app ID
#                     {slug} guesses are verified server-side; when the store
#                     doesn't answer 200, the store's own domain is searched
#                     for the real product page. If that also fails the tile
#                     is hidden for that game. Cached for 24h.
#
#   rewrite = <rule>  optional sed-style s/pattern/replacement/flags applied
#                     to the FINAL URL — whether it came from the template
#                     guess or from the search. Any delimiter works:
#                     s#...#...#g. JavaScript regex syntax; capture groups
#                     via $1, $2. Examples:
#                       append a partner tag:  rewrite = s#$#?partner=mytag#
#                       force GOG's UK site:   rewrite = s#www\.gog\.com#www.gog.com/en-gb#
#
# Changes take effect on the next game selection — no restart needed.

[Steam]
id = 1
url = https://store.steampowered.com/app/{steamAppID}
rewrite = 

[GamersGate]
id = 2
url = https://www.gamersgate.com/product/{slug}/
rewrite = 

